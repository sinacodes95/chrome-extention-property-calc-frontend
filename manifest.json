{
  "manifest_version": 3,
  "name": "Property Desk Calc",
  "description": "Underwrite property, project returns, and run financial and scientific calculations.",
  "version": "1.0.0",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_title": "Property Desk Calc",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "index.html#settings",
    "open_in_tab": true
  }
}
